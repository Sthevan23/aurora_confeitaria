# Aurora Confeitaria — URL limpa + modo OFF (Hostinger processos)

DirectoryIndex index.html

# ---- MODO OFF: arquivo SITE_OFF na raiz ----
# Apague SITE_OFF para religar o site.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{DOCUMENT_ROOT}/SITE_OFF -f
  RewriteCond %{REQUEST_URI} !/offline\.html$ [NC]
  RewriteRule ^ offline.html [L]

  # Força HTTPS (Hostinger)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Esconde index.html da barra de endereço
  RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Carrinho limpo: /carrinho → cart.html
  RewriteRule ^carrinho/?$ cart.html [L]

  # Foto faltando em /products → busca backup no MySQL (api/photo.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^products/([a-zA-Z0-9._-]+\.(jpe?g|png|webp|gif))$ api/photo.php?f=$1 [L,QSA,NC]
</IfModule>

# Catálogo estático — sem cache longo (admin liga/desliga na hora)
<IfModule mod_headers.c>
  <FilesMatch "^(catalog\.json)$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType application/json "access plus 2 minutes"
</IfModule>
