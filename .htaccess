# Aurora Confeitaria — URL limpa + modo OFF (Hostinger processos)

DirectoryIndex index.html

# ---- MODO OFF: arquivo SITE_OFF na raiz ----
# Apague SITE_OFF para religar o site.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{DOCUMENT_ROOT}/SITE_OFF -f
  RewriteCond %{REQUEST_URI} !/offline\.html$ [NC]
  RewriteRule ^ offline.html [L]

  # Força HTTPS (Hostinger)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Esconde index.html da barra de endereço
  RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Carrinho limpo: /carrinho → cart.html
  RewriteRule ^carrinho/?$ cart.html [L]

  # NÃO redirecionar foto faltando para photo.php — cada 404 virava processo PHP+MySQL
  # e derrubava o plano Hostinger (503 em tudo). Arquivo em products/ serve normal;
  # backup MySQL fica só no upload / photo.php?f= manual quando a API estiver ok.
</IfModule>

# Catálogo público — nunca cachear (preço/foto do painel precisam refletir na hora)
<IfModule mod_headers.c>
  <FilesMatch "^(catalog\.json|catalog\.live\.json)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  # JSON do cardápio NÃO entra em expires — ver FilesMatch acima
</IfModule>
